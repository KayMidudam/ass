local function StartRespawnHandler()
    if IsRespawning then
        return
    end

    IsRespawning = true
    Log("Death detected - pressing E to respawn")
    StatusText = "died"

    if RespawnConnection then
        RespawnConnection:Disconnect()
        RespawnConnection = nil
    end

    local startedAt = tick()
    local lastPressAt = 0

    RespawnConnection = RunService.Heartbeat:Connect(function()
        if not IsRespawning then
            if RespawnConnection then
                RespawnConnection:Disconnect()
                RespawnConnection = nil
            end
            return
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChild("Humanoid")

        if character and humanoid and humanoid.Health > 0 then
            StopRespawnHandler()
            StatusText = "Waiting"
            Log("Respawn detected, stopping handler")
            return
        end

        if tick() - startedAt < 0.6 then
            return
        end

        if tick() - lastPressAt >= 0.3 then
            lastPressAt = tick()

            local ok, err = pcall(function()
                PressE()
            end)

            if ok then
                Log("Pressed E for respawn")
            else
                Log("PressE failed: " .. tostring(err))
            end
        end
    end)
end

