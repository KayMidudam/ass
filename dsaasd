local AutoPickupRunning = false
local AutoPickupThread = nil
local PickupBusy = false

local function TryPickupNearbyCash()
	if Settings.IsDead then return end
	if PickupBusy then return end

	local folder = Workspace:FindFirstChild("Filter") and Workspace.Filter:FindFirstChild("SpawnedBread")
	local event = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("CZDPZUS")
	if not folder or not event then return end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return end

	local charPos = hrp.Position
	local closestPart = nil
	local closestDistance = math.huge

	for _, bread in ipairs(folder:GetChildren()) do
		if bread:IsA("BasePart") and bread.Parent and bread.Transparency < 1 then
			local dist = (charPos - bread.Position).Magnitude

			if dist <= (Settings.PickupDistance or 10) and dist < closestDistance then
				closestDistance = dist
				closestPart = bread
			end
		end
	end

	if closestPart then
		PickupBusy = true

		pcall(function()
			event:FireServer(closestPart)
		end)

		task.wait(0.3) -- 🔥 throttle (prevents spam)

		PickupBusy = false
	end
end

local function StartAutoPickup()
	if AutoPickupRunning then return end
	AutoPickupRunning = true

	AutoPickupThread = task.spawn(function()
		while AutoPickupRunning do
			TryPickupNearbyCash()
			task.wait(0.12)
		end
	end)
end

local function StopAutoPickup()
	AutoPickupRunning = false
	PickupBusy = false
end

