local function MainFarmLoop()
    Log("Autofarm loop started")
    RiseToTargetY()

    while true do
        task.wait(0.15)

        if not Settings.Enabled then
            task.wait(1)
            continue
        end

        Log("=== Farm cycle ===")

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        Settings.IsDead = (not humanoid) or (humanoid.Health <= 0)

        if Settings.IsDead then
            Log("Character dead, waiting")
            task.wait(3)
            continue
        end

        -- allowance / ATM first
        ProcessAllowanceIfReady()

        if FarmPriority.AllowanceActive then
            task.wait(0.3)
            continue
        end

        local didDeposit = ProcessDepositIfNeeded()

        if FarmPriority.DepositActive then
            task.wait(0.3)
            continue
        end

        if didDeposit then
            task.wait(0.3)
            continue
        end

        RiseToTargetY()

        if not HasTool("Crowbar") then
            Log("No crowbar, trying to buy")
            local bought = BuyCrowbar()
            if not bought then
                Log("Failed to purchase crowbar, waiting")
                task.wait(0.5)
                continue
            end
        else
            Log("Crowbar already owned")
        end

        local available, total = UpdateTargetsList()
        TotalAvailableTargets = available

        if available < 5 then
            Log("Few targets left (" .. available .. "), I recommend changing server")
        end

        if available == 0 then
            Log("No targets available, waiting")
            task.wait(0.5)
            continue
        end

        local nextTarget = nil
        local minDist = math.huge
        local currentHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

        if not currentHRP then
            task.wait(0.5)
            continue
        end

        for _, targetInfo in ipairs(SortedTargets) do
            if not Settings.TempIgnored[targetInfo.obj] then
                local dist = (targetInfo.pos - currentHRP.Position).Magnitude
                if dist < minDist then
                    minDist = dist
                    nextTarget = targetInfo.obj
                end
            end
        end

        if not nextTarget then
            Log("No valid target found, waiting")
            task.wait(0.5)
            continue
        end

        local mainPart = nextTarget:FindFirstChild("MainPart") or nextTarget.PrimaryPart
        if not mainPart then
            Log("Target has no MainPart, skipping")
            Settings.ProcessedList[nextTarget] = true
            continue
        end

        Log("Moving to target: " .. nextTarget.Name .. ", distance " .. math.floor((mainPart.Position - currentHRP.Position).Magnitude))

        local moveSuccess = GoToTarget(mainPart)

        if moveSuccess then
            if not EnsureCrowbarEquipped() then
                Log("Could not equip crowbar, skipping target")
                Settings.TempIgnored[nextTarget] = tick() + Settings.IgnoreDuration
                table.insert(Settings.IgnoredList, nextTarget)
                task.wait(0.5)
                continue
            end

            Log("Opening safe")
            local hackSuccess = HackSafe(nextTarget)

            if hackSuccess then
                ResetPathFails()
                Log("Safe opened, waiting for money...")

                task.wait(3)

                local startTime = tick()
                local maxCollectTime = 20
                local stillMoney = true

                while stillMoney and (tick() - startTime) < maxCollectTime do
                    local playerDataFolder2 = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
                    local cashData2 = playerDataFolder2 and playerDataFolder2:FindFirstChild(LocalPlayer.Name)
                    local nextAllowance2 = cashData2 and cashData2:FindFirstChild("NextAllowance")
                    local cashValue2 = cashData2 and cashData2:FindFirstChild("Cash")
                    local currentCash2 = cashValue2 and cashValue2.Value or 0

                    if nextAllowance2 and nextAllowance2.Value == 0 and not AutoClaimAllowanceCoolDown then
                        Log("Allowance became ready, pausing safe cycle")
                        break
                    end

                    if FarmPriority.DepositEnabled and currentCash2 >= (Settings.DepositThreshold or 5000) then
                        Log("Deposit threshold reached during safe cycle, pausing")
                        break
                    end

                    stillMoney = CollectMoneyNearTarget(nextTarget)
                    task.wait(1)
                end

                Settings.ProcessedList[nextTarget] = true
                Log("Safe fully processed")
            else
                Log("Failed to open safe, temporarily ignoring")
                Settings.TempIgnored[nextTarget] = tick() + Settings.IgnoreDuration
                table.insert(Settings.IgnoredList, nextTarget)
            end
        else
            -- do not increment here; MoveToTarget already counted the fail
            Log("Failed to reach target, temporarily ignoring")
            Settings.TempIgnored[nextTarget] = tick() + Settings.IgnoreDuration
            table.insert(Settings.IgnoredList, nextTarget)

            if Settings.IsDead then
                task.wait(2)
                continue
            end
        end

        task.wait(0.6)
    end
end

