local RunService = game:GetService("RunService")

local SoundKillRunning = false
local SoundKillLoop

local function KillSound(s)
	if not s:IsA("Sound") then return end

	-- instant kill
	pcall(function()
		s:Stop()
	end)

	s.Volume = 0
	s.Playing = false

	-- block future plays
	s:GetPropertyChangedSignal("Playing"):Connect(function()
		if s.Playing then
			s:Stop()
		end
	end)

	s:GetPropertyChangedSignal("Volume"):Connect(function()
		if s.Volume ~= 0 then
			s.Volume = 0
		end
	end)
end

local function EnableSoundKill()
	if SoundKillRunning then return end
	SoundKillRunning = true

	-- kill ALL current sounds
	for _, v in ipairs(game:GetDescendants()) do
		KillSound(v)
	end

	-- kill NEW sounds instantly
	game.DescendantAdded:Connect(function(v)
		if SoundKillRunning then
			KillSound(v)
		end
	end)

	-- safety loop (handles weird replays / engine sounds)
	SoundKillLoop = RunService.Heartbeat:Connect(function()
		if not SoundKillRunning then return end

		for _, s in ipairs(game:GetDescendants()) do
			if s:IsA("Sound") then
				if s.Playing then
					pcall(function() s:Stop() end)
				end
				if s.Volume ~= 0 then
					s.Volume = 0
				end
			end
		end
	end)
end

local function DisableSoundKill()
	SoundKillRunning = false

	if SoundKillLoop then
		SoundKillLoop:Disconnect()
		SoundKillLoop = nil
	end
end

