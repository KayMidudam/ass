--// MOVE TO TARGET
local function MoveToTarget(targetPart)
    RiseToTargetY()

    local character = LocalPlayer.Character
    if not character then
        Log("MoveToTarget: no character")
        RegisterPathFail("No character")
        return false
    end

    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then
        Log("MoveToTarget: no HRP or Humanoid")
        RegisterPathFail("No HRP or Humanoid")
        return false
    end

    if not targetPart or not targetPart:IsA("BasePart") then
        Log("MoveToTarget: invalid target")
        RegisterPathFail("Invalid target")
        return false
    end

    CurrentTargetPart = targetPart
    IsMovingToTarget = true
    SomeFlag2 = false
    StatusText = "Path to target"

    local startPos = hrp.Position
    local targetFrontPos = GetPositionInFrontOfTarget(targetPart, startPos)

    if not targetFrontPos then
        Log("MoveToTarget: failed to calculate front position")
        IsMovingToTarget = false
        StatusText = "Waiting"
        RegisterPathFail("Front position failed")
        return false
    end

    local endPos = targetFrontPos
    Log("Searching path to target, distance " .. math.floor((endPos - startPos).Magnitude))

    local path = ComputePath(startPos, endPos)
    if not path or #path == 0 then
        Log("MoveToTarget: path not found")
        IsMovingToTarget = false
        StatusText = "Waiting"
        RegisterPathFail("Path not found")
        return false
    end

    Log("Path found, waypoints: " .. #path)
    VisualizePath(path, startPos)

    local moveStartTime = tick()
    local MOVE_TIMEOUT = 45

    for _, waypoint in ipairs(path) do
        if not Settings.Enabled then
            ClearPathVisuals()
            IsMovingToTarget = false
            StatusText = "Waiting"
            return false
        end

        if (tick() - moveStartTime) > MOVE_TIMEOUT then
            Log("MoveToTarget: timeout")
            ClearPathVisuals()
            IsMovingToTarget = false
            StatusText = "Waiting"
            RegisterPathFail("Move timeout")
            return false
        end

        local targetPos = waypoint.Position
        local targetHRP = targetPos + Vector3.new(0, 2.5, 0)
        local currentRot = hrp.CFrame - hrp.CFrame.Position
        local targetCF = CFrame.new(targetHRP) * currentRot
        local dist = (targetHRP - hrp.Position).Magnitude

        if dist > 0.2 then
            local tween = TweenService:Create(
                hrp,
                TweenInfo.new(dist / Settings.MoveSpeed, Enum.EasingStyle.Linear),
                { CFrame = targetCF }
            )
            tween:Play()
            tween.Completed:Wait()
            LastTick = tick()
        end

        if waypoint.Action == Enum.PathWaypointAction.Jump then
            humanoid.Jump = true
            task.wait(0.1)
        end
    end

    ClearPathVisuals()

    local finalPos = endPos
    local finalHRP = finalPos + Vector3.new(0, 2.5, 0)
    hrp.CFrame = CFrame.new(finalHRP) * CFrame.Angles(0, math.rad(90), 0)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    Log("Target reached")
    IsMovingToTarget = false
    StatusText = "Waiting"
    ResetPathFails()
    return true
end


