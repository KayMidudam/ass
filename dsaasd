--========================
local function FlyToPosition(targetPos, timeout)
	local start = tick()
	local lastPos = nil
	local stuckTime = 0

	while Settings.Enabled and IsMovingToTarget and IsAliveForFly() do
		SetNoclip(true)

		local char = LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return false end

		local offset = targetPos - hrp.Position
		local dist = offset.Magnitude

		if dist <= 2 then
			return true
		end

		if tick() - start > timeout then
			FlyFailCount += 1
			return false
		end

		if lastPos then
			if (hrp.Position - lastPos).Magnitude < 0.5 then
				stuckTime += RunService.RenderStepped:Wait()
				if stuckTime > 0.4 then
					hrp.CFrame = hrp.CFrame + Vector3.new(
						math.random(-3,3), 2, math.random(-3,3)
					)
					stuckTime = 0
				end
			else
				stuckTime = 0
			end
		end

		lastPos = hrp.Position

		local dir = offset.Unit
		hrp.AssemblyLinearVelocity = dir * flySpd
		hrp.AssemblyAngularVelocity = Vector3.zero

		if flyEv then
			pcall(function()
				flyEv:FireServer("---r", Vector3.zero, hrp.CFrame, false)
			end)
		end

		MakeFlyStiff()
		RunService.RenderStepped:Wait()
	end

	return false
end

