-- Auto Lockpick Safes (FULL FIX + FAST + AUTO EQUIP)
-- Changes:
-- 1) Faster cadence: COOLDOWN = 0.1
-- 2) Auto-equips a Lockpick from Backpack when none is equipped
-- 3) Clears stale tool refs when a lockpick breaks/deletes
-- 4) Detects newly equipped lockpick instance and waits briefly for it to settle

--// SERVICES
local Players = game:GetService("Players")

--// PLAYER
local player = Players.LocalPlayer

--// MAP
local folder = workspace:WaitForChild("Map"):WaitForChild("BredMakurz")

--// SETTINGS
local ManualFarmEnabled = false
local ManualFarmBusy = false
local lastRun = 0
local COOLDOWN = 0.1
local RANGE = 10

--// STATE
local CurrentTool = nil
local CurrentRemote = nil
local LastToolId = nil
local LastEquipTime = 0

--// FUNCTIONS
local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function getBackpack()
	return player:WaitForChild("Backpack")
end

local function getHumanoid()
	local char = getCharacter()
	return char:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
	local char = getCharacter()
	return char:FindFirstChild("HumanoidRootPart")
end

local function getPosition(obj)
	if obj:IsA("Model") then
		return obj:GetPivot().Position
	elseif obj:IsA("BasePart") then
		return obj.Position
	end
end

local function getClosestSafe()
	local hrp = getHRP()
	if not hrp then
		return nil
	end

	local closest, dist = nil, math.huge

	for _, safe in ipairs(folder:GetChildren()) do
		if safe.Name:find("Safe") then
			local pos = getPosition(safe)
			if pos then
				local d = (pos - hrp.Position).Magnitude
				if d < dist then
					dist = d
					closest = safe
				end
			end
		end
	end

	return closest
end

local function clearToolState()
	CurrentTool = nil
	CurrentRemote = nil
	LastToolId = nil
	LastEquipTime = 0
end

local function equipLockpickFromBackpack()
	local char = getCharacter()
	local humanoid = getHumanoid()
	local backpack = getBackpack()

	if not char or not humanoid or not backpack then
		return nil
	end

	local equipped = char:FindFirstChild("Lockpick")
	if equipped and equipped:IsA("Tool") then
		return equipped
	end

	local stored = backpack:FindFirstChild("Lockpick")
	if not stored or not stored:IsA("Tool") then
		return nil
	end

	pcall(function()
		humanoid:EquipTool(stored)
	end)

	task.wait(0.1)

	local newEquipped = char:FindFirstChild("Lockpick")
	if newEquipped and newEquipped:IsA("Tool") then
		return newEquipped
	end

	return nil
end

local function refreshEquippedLockpick()
	local char = getCharacter()

	-- if old cached tool got destroyed / removed, clear it
	if CurrentTool and CurrentTool.Parent == nil then
		clearToolState()
	end

	-- ONLY use equipped lockpick, but auto-equip one from backpack if needed
	local tool = char:FindFirstChild("Lockpick")
	if not tool or not tool:IsA("Tool") then
		tool = equipLockpickFromBackpack()
	end

	if not tool or not tool:IsA("Tool") then
		clearToolState()
		return nil, nil
	end

	local debugId = nil
	local ok = pcall(function()
		debugId = tool:GetDebugId()
	end)

	if not ok or not debugId then
		clearToolState()
		return nil, nil
	end

	-- detect brand new equipped lockpick instance
	if debugId ~= LastToolId then
		CurrentTool = tool
		CurrentRemote = tool:FindFirstChild("Remote")
		LastToolId = debugId
		LastEquipTime = tick()
		print("New lockpick equipped:", debugId)
	else
		-- keep refreshing remote in case children changed
		CurrentTool = tool
		CurrentRemote = tool:FindFirstChild("Remote")
	end

	if not CurrentRemote then
		return nil, CurrentTool
	end

	return CurrentRemote, CurrentTool
end

local function RunManualFarm()
	if ManualFarmBusy then
		return
	end
	ManualFarmBusy = true

	local ok, err = pcall(function()
		local remote, tool = refreshEquippedLockpick()

		if not remote or not tool then
			print("No lockpick available")
			return
		end

		-- wait a little after equip so server fully accepts new tool
		if (tick() - LastEquipTime) < 0.1 then
			return
		end

		-- if the tool disappeared between checks, stop immediately
		if tool.Parent == nil then
			clearToolState()
			return
		end

		local safe = getClosestSafe()
		if not safe then
			return
		end

		local pos = getPosition(safe)
		local hrp = getHRP()
		if not pos or not hrp then
			return
		end

		local dist = (pos - hrp.Position).Magnitude
		if dist > RANGE then
			return
		end

		print("Closest safe:", safe.Name)

		local sValue = remote:InvokeServer("S", safe, "s")
		print("S:", sValue)

		if not sValue then
			return
		end

		local dValue = remote:InvokeServer("D", safe, "s", sValue)
		local cValue = remote:InvokeServer("C")

		print("Done:", dValue, cValue)

		task.wait(0.05)

		-- if the lockpick got destroyed after use, forget it immediately
		if tool.Parent == nil then
			print("Lockpick broke and was deleted.")
			clearToolState()
			return
		end

		-- if equipped tool changed, refresh state
		local char = getCharacter()
		local equippedNow = char:FindFirstChild("Lockpick")
		if equippedNow ~= tool then
			clearToolState()
			return
		end
	end)

	if not ok then
		warn("ManualFarm error:", err)
		clearToolState()
	end

	ManualFarmBusy = false
end

--// LOOP
task.spawn(function()
	while true do
		task.wait(0.1)

		local ok, err = pcall(function()
			if not ManualFarmEnabled then
				return
			end

			if ManualFarmBusy then
				return
			end

			local safe = getClosestSafe()
			if not safe then
				return
			end

			local pos = getPosition(safe)
			local hrp = getHRP()
			if not pos or not hrp then
				return
			end

			if (pos - hrp.Position).Magnitude > RANGE then
				return
			end

			if (tick() - lastRun) >= COOLDOWN then
				lastRun = tick()
				RunManualFarm()
			end
		end)

		if not ok then
			warn("Loop crash:", err)
			clearToolState()
			ManualFarmBusy = false
		end
	end
end)


