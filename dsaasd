local function TeleportToTarget(targetPart)
	local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")

	if not hrp or not hum or not targetPart then return false end

	-- RESET FIRST
	StopFlyMove()

	IsMovingToTarget = true
	StatusText = "Flying"

	local startPos = hrp.Position
	local frontPos = GetPositionInFrontOfTarget(targetPart, startPos) or targetPart.Position
	local finalPos = frontPos + Vector3.new(0, 2.5, 0)

	local path = ComputePath(startPos, finalPos)
	if not path or #path == 0 then
		IsMovingToTarget = false
		return false
	end

	-- START SYSTEMS
	StartFlyRagLoop()
	EnableSoundKill()
	ShowBlackScreen()

	local success = true

	for _, waypoint in ipairs(path) do
		if not Settings.Enabled then
			success = false
			break
		end

		local wpPos = waypoint.Position + Vector3.new(0, 2.5, 0)

		if waypoint.Action == Enum.PathWaypointAction.Jump then
			hum.Jump = true
		end

		if not FlyToPosition(wpPos, 8) then
			if FlyFailCount >= MAX_FLY_FAILS then
				Log("Fly failed → reset")

				local pos = hrp.Position
				hrp.CFrame = CFrame.new(pos.X, Settings.TargetY, pos.Z)

				FlyFailCount = 0
				success = false
				break
			end
		end
	end

	if success then
		FlyToPosition(finalPos, 10)
		FlyFailCount = 0
	end

	-- FINAL STOP
	StopFlyMove()
	IsMovingToTarget = false

	HideBlackScreen()

	-- FINAL SNAP (3x)
	if hrp then
		SnapToPosition(hrp, finalPos)
	end

	if hum then
		hum.PlatformStand = false
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	return success
end
