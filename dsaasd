local function ProcessAllowanceIfReady()
    if not FarmPriority.AllowanceEnabled then
        return
    end

    local _, hrp = WaitForCharacter()
    if not hrp then
        return
    end

    local playerDataFolder = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
    if not playerDataFolder then
        Log("Allowance: PlayerbaseData2 missing")
        return
    end

    local cashData = playerDataFolder:FindFirstChild(LocalPlayer.Name)
    if not cashData then
        Log("Allowance: cashData missing")
        return
    end

    local nextAllowance = cashData:FindFirstChild("NextAllowance")

    if nextAllowance and nextAllowance.Value == 0 and not AutoClaimAllowanceCoolDown then
        FarmPriority.AllowanceActive = true
        AutoClaimAllowanceCoolDown = true

        Log("Allowance ready, starting ATM logic")

        local targetATM = GetATM()
        if not targetATM then
            Log("Allowance ready but no ATM found")
            AutoClaimAllowanceCoolDown = false
            FarmPriority.AllowanceActive = false
            return
        end

        Log("Using ATM: " .. targetATM:GetFullName())

        local movedToATM = GoToTarget(targetATM)
        if not movedToATM then
            Log("Failed to reach ATM")
            AutoClaimAllowanceCoolDown = false
            FarmPriority.AllowanceActive = false
            return
        end

        task.wait(0.4)

        local claimed = ClaimAllowanceAtATM(targetATM)

        if claimed then
            Log("Allowance claim succeeded")
        else
            Log("Allowance claim failed")
        end

        task.wait(0.5)

        local startTime = tick()
        local maxDepositTime = 20
        local stillDepositing = true

        while stillDepositing and (tick() - startTime) < maxDepositTime do
            if not Settings.Enabled then
                break
            end

            local aliveCharacter = LocalPlayer.Character
            local aliveHumanoid = aliveCharacter and aliveCharacter:FindFirstChildOfClass("Humanoid")
            if not aliveHumanoid or aliveHumanoid.Health <= 0 then
                break
            end

            local cashValue = cashData:FindFirstChild("Cash")
            local cash = cashValue and cashValue.Value or 0

            if cash < 10 then
                Log("Cash is already below 10, ATM finished")
                stillDepositing = false
                break
            end

            cash = RefreshCashAfterDrop(cashData, cash)

            if cash < 10 then
                Log("Cash refreshed below 10 after drop, ATM finished")
                stillDepositing = false
                break
            end

            DepositCashAtATM(targetATM, cash)

            local newCashValue = cashData:FindFirstChild("Cash")
            local newCash = newCashValue and newCashValue.Value or 0

            if newCash < 10 then
                Log("Allowance deposit successful, cash is now below 10")
                stillDepositing = false
                break
            end

            if newCash >= cash then
                Log("Cash did not decrease, stopping ATM loop")
                stillDepositing = false
                break
            end
        end

        ATMUsage[targetATM] = (ATMUsage[targetATM] or 0) + 1
        AutoClaimAllowanceCoolDown = false
        FarmPriority.AllowanceActive = false

        Log("Allowance logic finished, returning to safe farm")
    end
end

local function ProcessDepositIfNeeded()
    if not FarmPriority.DepositEnabled then
        return false
    end

    if FarmPriority.AllowanceActive then
        return false
    end

    if AutoClaimAllowanceCoolDown then
        return false
    end

    local _, hrp = WaitForCharacter()
    if not hrp then
        return false
    end

    local playerDataFolder = ReplicatedStorage:FindFirstChild("PlayerbaseData2")
    if not playerDataFolder then
        Log("Deposit: PlayerbaseData2 missing")
        return false
    end

    local cashData = playerDataFolder:FindFirstChild(LocalPlayer.Name)
    if not cashData then
        Log("Deposit: cashData missing")
        return false
    end

    local cashValue = cashData:FindFirstChild("Cash")
    local cash = cashValue and cashValue.Value or 0

    if cash < Settings.DepositThreshold then
        return false
    end

    Log("Deposit threshold reached (" .. tostring(cash) .. "), starting ATM deposit")
    FarmPriority.DepositActive = true

    local targetATM = GetATM()
    if not targetATM then
        Log("Deposit: no ATM found")
        FarmPriority.DepositActive = false
        return false
    end

    local movedToATM = GoToTarget(targetATM)
    if not movedToATM then
        Log("Deposit: failed to reach ATM")
        FarmPriority.DepositActive = false
        return false
    end

    task.wait(0.4)

    local startTime = tick()
    local maxDepositTime = 20
    local depositSuccess = false

    while (tick() - startTime) < maxDepositTime do
        if not Settings.Enabled then
            break
        end

        local aliveCharacter = LocalPlayer.Character
        local aliveHumanoid = aliveCharacter and aliveCharacter:FindFirstChildOfClass("Humanoid")
        if not aliveHumanoid or aliveHumanoid.Health <= 0 then
            break
        end

        local currentCashValue = cashData:FindFirstChild("Cash")
        local currentCash = currentCashValue and currentCashValue.Value or 0

        if currentCash < 10 then
            depositSuccess = true
            Log("Deposit successful, cash is now below 10")
            break
        end

        currentCash = RefreshCashAfterDrop(cashData, currentCash)

        if currentCash < 10 then
            depositSuccess = true
            Log("Deposit successful after refresh, cash is now below 10")
            break
        end

        DepositCashAtATM(targetATM, currentCash)

        local afterCashValue = cashData:FindFirstChild("Cash")
        local afterCash = afterCashValue and afterCashValue.Value or 0

        if afterCash < 10 then
            depositSuccess = true
            Log("Deposit successful, cash is now below 10")
            break
        end

        if afterCash >= currentCash then
            Log("Deposit did not reduce cash, stopping deposit loop")
            break
        end
    end

    FarmPriority.DepositActive = false

    if depositSuccess then
        Log("Deposit process finished successfully")
    else
        Log("Deposit process ended without full success")
    end

    return depositSuccess
end

