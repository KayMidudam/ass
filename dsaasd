    status.Font = Enum.Font.GothamSemibold
    status.TextSize = 14
    status.TextXAlignment = Enum.TextXAlignment.Center

    EspElements[v] = {billboard = billboard, title = title, distance = distance, status = status}
    return EspElements[v]
end

local function UpdateESP(delta)
    if not EspEnabled then return end

    local bredFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("BredMakurz")
    if not bredFolder then return end

    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    for _, v in pairs(bredFolder:GetChildren()) do
        local nameLower = v.Name:lower()
        if nameLower:find("safe") or nameLower:find("register") then
            local isBroken = GetBrokenValue(v)
            local isSafe = nameLower:find("safe")

            if isBroken then
                if not SafeTimers[v.Name] then SafeTimers[v.Name] = 720 end
                if SafeTimers[v.Name] > 0 then SafeTimers[v.Name] = SafeTimers[v.Name] - delta end
            else
                SafeTimers[v.Name] = nil
            end

            local mainPart = GetMainPart(v)
            if mainPart then
                local esp = CreateTextESP(v)
                if esp then
                    esp.title.Text = (isSafe and "🔒 " or "💰 ") .. FormatName(v.Name)

                    local dist = math.floor((mainPart.Position - hrp.Position).Magnitude / 3)
                    esp.distance.Text = dist .. "m"

                    if isBroken and SafeTimers[v.Name] and SafeTimers[v.Name] > 0 then
                        local p = SafeTimers[v.Name]
                        local m = math.floor(p / 60)
                        local s = math.floor(p % 60)
                        esp.status.Text = string.format("[COOLDOWN] %02d:%02d", m, s)
                        esp.status.TextColor3 = Color3.fromRGB(255, 140, 60)
                    else
                        esp.status.Text = "[READY]"
                        esp.status.TextColor3 = Color3.fromRGB(0, 255, 130)
                    end
                end
            end
        end
    end

    for obj, data in pairs(EspElements) do
        if not obj or not obj.Parent then
            if data.billboard then data.billboard:Destroy() end
            EspElements[obj] = nil
            SafeTimers[obj and obj.Name] = nil
        end
    end
end

local function EnableESP()
    if EspEnabled then return end
    EspEnabled = true
    local last = tick()
    EspConnection = RunService.Heartbeat:Connect(function()
        local now = tick()
        UpdateESP(now - last)
        last = now
    end)
end

local function DisableESP()
    if not EspEnabled then return end
    EspEnabled = false
    if EspConnection then EspConnection:Disconnect() end
    for _, data in pairs(EspElements) do
        if data.billboard then data.billboard:Destroy() end
    end
    EspElements = {}
    SafeTimers = {}
end
