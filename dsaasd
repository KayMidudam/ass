local function FindATMPartInside(instance)
    if not instance then
        return nil
    end

    if instance:IsA("BasePart") and instance.Name == "MainPart" then
        return instance
    end

    if instance:IsA("Model") then
        local directMainPart = instance:FindFirstChild("MainPart")
        if directMainPart and directMainPart:IsA("BasePart") then
            return directMainPart
        end

        if instance.PrimaryPart and instance.PrimaryPart:IsA("BasePart") then
            return instance.PrimaryPart
        end
    end

    for _, descendant in ipairs(instance:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == "MainPart" then
            return descendant
        end
    end

    if instance:IsA("Model") then
        for _, descendant in ipairs(instance:GetDescendants()) do
            if descendant:IsA("Model") and descendant.PrimaryPart and descendant.PrimaryPart:IsA("BasePart") then
                return descendant.PrimaryPart
            end
        end
    end

    return nil
end

local function GetATM()
    local _, hrp = WaitForCharacter()
    if not hrp then
        Log("GetATM: no HRP")
        return nil, math.huge
    end

    local map = Workspace:FindFirstChild("Map")
    if not map then
        Log("GetATM: Map missing")
        return nil, math.huge
    end

    local atmFolder = map:FindFirstChild("ATMz")
    if not atmFolder then
        Log("GetATM: ATMz folder missing")
        return nil, math.huge
    end

    local closestATM = nil
    local minDistance = math.huge

    for _, child in ipairs(atmFolder:GetChildren()) do
        local mainPart = FindATMPartInside(child)

        if mainPart and mainPart:IsA("BasePart") then
            local usageCount = ATMUsage[mainPart] or 0
            if usageCount < 999 then
                local atmDistance = (hrp.Position - mainPart.Position).Magnitude
                if atmDistance < minDistance then
                    minDistance = atmDistance
                    closestATM = mainPart
                end
            end
        end
    end

    if closestATM then
        Log("GetATM: selected " .. closestATM:GetFullName())
    else
        Log("GetATM: no valid ATM found")
    end

    return closestATM, minDistance
end

